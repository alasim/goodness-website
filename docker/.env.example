# GOODNESS OS — local stack configuration.
#
# Do not fill this in by hand: run `npm run stack:keys` in the repository root and it writes
# docker/.env with a fresh password, JWT secret and matching anon / service-role keys.
# This file documents what ends up there.

POSTGRES_DB=postgres
POSTGRES_PASSWORD=<generated>

JWT_SECRET=<generated, 32+ bytes>
JWT_EXPIRY=3600
ANON_KEY=<JWT signed with JWT_SECRET, role=anon>
SERVICE_ROLE_KEY=<JWT signed with JWT_SECRET, role=service_role>

SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://localhost:3000/**
SUPABASE_PUBLIC_URL=http://localhost:54321

API_PORT=54321
POSTGRES_PORT_EXTERNAL=54322
STUDIO_PORT=54323
MAIL_PORT=54324

# false brings the stack up with the schema but no content
APPLY_SEED=true
# true signs users in without the emailed link — useful for automated runs
MAILER_AUTOCONFIRM=false

PGRST_DB_SCHEMAS=public
STUDIO_DEFAULT_ORGANIZATION=Goodness Society
STUDIO_DEFAULT_PROJECT=GOODNESS OS
